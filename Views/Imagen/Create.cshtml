<div id="app">


<h2>Nueva Imagen</h2>

<form @@submit.prevent="crearImagen">

    <label>Inmueble</label>

    <select v-model="imagen.IdInmueble" class="form-control">

        <option value="">
            Seleccione un inmueble
        </option>

        <option v-for="inmueble in inmuebles"
                :key="inmueble.IdInmueble"
                :value="inmueble.IdInmueble">

            {{ inmueble.Direccion }}

        </option>

    </select>

    <br>

    <label>Seleccione las imágenes</label>

    <div style="
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 10px;
    ">

        <div v-for="archivo in archivos"
             :key="archivo"
             @@click="seleccionarImagen(archivo)"
             :style="{
                 border: imagenesSeleccionadas.includes(archivo)
                     ? '4px solid blue'
                     : '2px solid #ddd',

                 padding: '5px',
                 borderRadius: '8px',
                 cursor: 'pointer'
             }">

            <img :src="archivo"
                 alt="Imagen"
                 style="
                    width: 180px;
                    height: 120px;
                    object-fit: cover;
                    border-radius: 5px;
                 ">

        </div>

    </div>

    <br>

    <div v-if="imagenesSeleccionadas.length > 0">

        <strong>
            Imágenes seleccionadas:
        </strong>

        <ul>

            <li v-for="imagen in imagenesSeleccionadas"
                :key="imagen">

                {{ imagen }}

            </li>

        </ul>

    </div>

    <br>

    <div v-if="imagenesSeleccionadas.length > 0">

        <label>
            Seleccione cuál será la imagen de portada:
        </label>

        <div style="
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 10px;
        ">

            <div v-for="imagen in imagenesSeleccionadas"
                 :key="imagen"
                 @@click="seleccionarPortada(imagen)"
                 :style="{
                     border: imagenPortada === imagen
                         ? '4px solid green'
                         : '2px solid #ddd',

                     padding: '5px',
                     borderRadius: '8px',
                     cursor: 'pointer'
                 }">

                <img :src="imagen"
                     alt="Portada"
                     style="
                        width: 180px;
                        height: 120px;
                        object-fit: cover;
                        border-radius: 5px;
                     ">

                <div style="
                    text-align: center;
                    margin-top: 5px;
                ">

                    <strong v-if="imagenPortada === imagen">
                        PORTADA
                    </strong>

                </div>

            </div>

        </div>

    </div>

    <br>

    <button type="submit"
            class="btn btn-success">

        Guardar

    </button>

    <a href="/Imagen"
       class="btn btn-secondary">

        Cancelar

    </a>

</form>


</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Imagen.js"></script>
