<div id="app">


<h1>Reservas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nueva Reserva
    </a>
</p>

<table class="table">

    <thead>
        <tr>
            <th>Id Reserva</th>
            <th>Id Inquilino</th>
            <th>Id Inmueble</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Monto por Día</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        <tr v-for="reserva in reservas"
            :key="reserva.IdReserva">

            <td>{{reserva.IdReserva}}</td>
            <td>{{reserva.IdInquilino}}</td>
            <td>{{reserva.IdInmueble}}</td>
            <td>{{reserva.FechaInicio}}</td>
            <td>{{reserva.FechaFin}}</td>
            <td>{{reserva.MontoPorDia}}</td>

            <td>

                <a :href="'/Reserva/Edit/' + reserva.IdReserva"
                   class="btn btn-warning">
                    Editar
                </a>

                <a :href="'/Reserva/Delete/' + reserva.IdReserva"
                  class="btn btn-danger">
                    Eliminar
                </a>

                <a :href="'/Reserva/Details/' + reserva.IdReserva"
                   class="btn btn-warning">
                    Details
                </a>

            </td>

        </tr>

    </tbody>

</table>


</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Reserva.js"></script>
