<div id="app" v-cloak>

    <h1>Reservas</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            Nueva Reserva
        </a>
    </p>

    <table class="table">

        <thead>
            <tr>
                <th>Id Reserva</th>
                <th>Id Inquilino</th>
                <th>Id Inmueble</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Monto por Día</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="reserva in reservas"
                :key="reserva.IdReserva">

                <td>
                    {{ reserva.IdReserva }}
                </td>

                <td>
                    {{ reserva.IdInquilino }}
                </td>

                <td>
                    {{ reserva.IdInmueble }}
                </td>

                <td>
                    {{ reserva.FechaInicio }}
                </td>

                <td>
                    {{ reserva.FechaFin }}
                </td>

                <td>
                    {{ reserva.MontoPorDia }}
                </td>

                <td>

                    <a :href="'/Reserva/Edit/' + reserva.IdReserva"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a :href="'/Reserva/Delete/' + reserva.IdReserva"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                    <a :href="'/Reserva/Details/' + reserva.IdReserva"
                       class="btn btn-warning">
                        Details
                    </a>

                </td>

            </tr>

        </tbody>

    </table>

    <hr />

    <h2>Reporte de Reservas por Período</h2>

    <label>
        Fecha de inicio
    </label>

    <input type="date"
           v-model="fechaReporteInicio"
           class="form-control" />

    <br />

    <label>
        Fecha de fin
    </label>

    <input type="date"
           v-model="fechaReporteFin"
           class="form-control" />

    <br />

    <button class="btn btn-primary"
            v-on:click="listarReservasPorPeriodo">

        Buscar reservas

    </button>

    <table class="table">

        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Monto por Día</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="reserva in reservasReporte"
                :key="reserva.IdReserva">

                <td>
                    {{ reserva.Inquilino }}
                </td>

                <td>
                    {{ reserva.Inmueble }}
                </td>

                <td>
                    {{ reserva.FechaInicio }}
                </td>

                <td>
                    {{ reserva.FechaFin }}
                </td>

                <td>
                    {{ reserva.MontoPorDia }}
                </td>

            </tr>

        </tbody>

    </table>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Reserva.js"></script>