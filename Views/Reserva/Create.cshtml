<div id="app" v-cloak>


<h1>Nueva Reserva</h1>

<form @@submit.prevent="crearReserva">

    <div class="mb-3">
    <label>Inquilino</label>

    <select v-model="reserva.IdInquilino"
            class="form-control">

        <option value="0">
            Seleccione un inquilino
        </option>

        <option v-for="inquilino in inquilinos"
                :key="inquilino.IdInquilino"
                :value="inquilino.IdInquilino">

            {{ inquilino.NombreCompleto }} 

        </option>

    </select>
    </div>
<div class="mb-3">
    <label>Inmueble</label>

    <div class="position-relative">

        <input v-model="busquedaInmueble"
               class="form-control"
               type="text"
               placeholder="Buscar inmueble por dirección..."
               autocomplete="off"
               @@focus="mostrarInmuebles = true" />

        <div v-if="mostrarInmuebles && inmueblesFiltrados.length > 0"
             class="list-group position-absolute w-100"
             style="z-index: 1000;">

            <button v-for="inmueble in inmueblesFiltrados"
                    :key="inmueble.IdInmueble"
                    type="button"
                    class="list-group-item list-group-item-action"
                    @@click="seleccionarInmueble(inmueble)">

                {{ inmueble.Direccion }}

            </button>

        </div>

        <div v-if="mostrarInmuebles &&
                  busquedaInmueble &&
                  inmueblesFiltrados.length === 0"
             class="list-group position-absolute w-100"
             style="z-index: 1000;">

            <div class="list-group-item">
                No se encontraron inmuebles.
            </div>

        </div>

    </div>
</div>
    <div class="mb-3">
        <label>Fecha de inicio</label>
        <input v-model="reserva.FechaInicio"
               class="form-control"
               type="date" />
    </div>

    <div class="mb-3">
        <label>Fecha de fin</label>
        <input v-model="reserva.FechaFin"
               class="form-control"
               type="date" />
    </div>

    <div class="mb-3">
        <label>Monto por día</label>
        <input v-model="reserva.MontoPorDia"
               class="form-control"
               type="number"
               step="0.01" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a href="/Reserva" class="btn btn-secondary">
        Volver
    </a>

</form>


</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Reserva.js"></script>
