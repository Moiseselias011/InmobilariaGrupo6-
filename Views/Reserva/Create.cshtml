<div id="app">


<h1>Nueva Reserva</h1>

<form @@submit.prevent="crearReserva">

    <div class="mb-3">
        <label>Id Inquilino</label>
        <input v-model="reserva.IdInquilino"
               class="form-control"
               type="number" />
    </div>

    <div class="mb-3">
        <label>Id Inmueble</label>
        <input v-model="reserva.IdInmueble"
               class="form-control"
               type="number" />
    </div>

    <div class="mb-3">
        <label>Fecha de inicio</label>
        <input v-model="reserva.FechaInicio"
               class="form-control"
               type="date" />
    </div>

    <div class="mb-3">
        <label>Fecha de fin</label>
        <input v-model="reserva.FechaFin"
               class="form-control"
               type="date" />
    </div>

    <div class="mb-3">
        <label>Monto por día</label>
        <input v-model="reserva.MontoPorDia"
               class="form-control"
               type="number"
               step="0.01" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a href="/Reserva" class="btn btn-secondary">
        Volver
    </a>

</form>


</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Reserva.js"></script>
