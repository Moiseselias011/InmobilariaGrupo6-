<div id="app">

<h2>Eliminar Reserva</h2>

<div v-if="reserva">

    <p><strong>Id Inquilino:</strong> {{reserva.IdInquilino}}</p>
    <p><strong>Id Inmueble:</strong> {{reserva.IdInmueble}}</p>
    <p><strong>Fecha Inicio:</strong> {{reserva.FechaInicio}}</p>
    <p><strong>Fecha Fin:</strong> {{reserva.FechaFin}}</p>
    <p><strong>Monto por Día:</strong> {{reserva.MontoPorDia}}</p>

</div>

<br>

<button @@click="eliminar" class="btn btn-danger">
    Eliminar
</button>

<a class="btn btn-secondary" href="/Reserva">
    Cancelar
</a>


</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Reserva.js"></script>
