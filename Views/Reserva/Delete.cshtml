@model InmobilariaGrupo6_.Models.Reserva

@{
    ViewData["Title"] = "Eliminar Reserva";
}

<h1>Eliminar Reserva</h1>

<h3>¿Está seguro de que desea eliminar esta reserva?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Id Reserva
    </dt>
    <dd class="col-sm-9">
        @Model.IdReserva
    </dd>

    <dt class="col-sm-3">
        Id Inquilino
    </dt>
    <dd class="col-sm-9">
        @Model.IdInquilino
    </dd>

    <dt class="col-sm-3">
        Id Inmueble
    </dt>
    <dd class="col-sm-9">
        @Model.IdInmueble
    </dd>

    <dt class="col-sm-3">
        Fecha de inicio
    </dt>
    <dd class="col-sm-9">
        @Model.FechaInicio.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">
        Fecha de fin
    </dt>
    <dd class="col-sm-9">
        @Model.FechaFin.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">
        Monto por día
    </dt>
    <dd class="col-sm-9">
        @Model.MontoPorDia.ToString("C")
    </dd>

</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="IdReserva" />

    <button type="submit" class="btn btn-danger">
        Sí, eliminar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>