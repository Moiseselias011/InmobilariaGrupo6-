
@model InmobilariaGrupo6_.Models.Reserva

<h2>Eliminar Reserva</h2>

<div>
    <p><strong>FechaInicio:</strong> @Model.FechaInicio</p>
    <p><strong>FechaFin:</strong> @Model.FechaFin</p>
    <p><strong>MontoPorDia:</strong> @Model.MontoPorDia</p>
</div>

<br>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" name="id" value="@Model.IdReserva" />

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    <a class="btn btn-secondary" href="/Reserva">
        Cancelar
    </a>

</form>

