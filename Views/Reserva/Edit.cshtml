<div id="app">

<h1>Editar Reserva</h1>

<form @@submit.prevent="editarReserva">

<input type="hidden" v-model="reserva.IdReserva"/>


<div class="fmb-3">
<label> Inquilino</label>
<input v-model="reserva.IdInquilino"class="form-control"/>
</div>

<div class="mb-3">
<label>Inmueble </label>
<input v-model="reserva.IdInmueble" class="form-control"/>
</div>

<div class="mb-3">
<label> Fecha de inicio</label>
<input v-model="reserva.FechaInicio"class="form-control"/>
</div>

<div class="mb-3">
<label>Fecha de fin</label>
<input v-model="reserva.FechaFin"class="form-control"/>
</div>

<div class="mb-3">
<label>Monto por día</label>
<input v-model="reserva.MontoPorDia"class="form-control"/>
</div>

<button type="submit" class ="btn btn-success">Guardar cambios</button>

 <a class="btn btn-secondary" href="/Reserva">
 Cancelar </a>


</form> 

</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Reserva.js"></script>