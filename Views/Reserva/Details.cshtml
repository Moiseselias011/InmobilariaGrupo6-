<div id="app">

<h1>Detalles de la Reserva</h1>

<<div v-if="reserva && reserva.Inquilino && reserva.Inmueble">>

    <p><strong> Id Reserva :</strong> {{reserva.IdReserva}} </p>

    <p><strong>Inquilino:</strong> {{reserva.Inquilino.NombreCompleto}}</p>

    <p><strong>Inmueble:</strong> {{reserva.Inmueble.Direccion}}</p>

    <p><strong> Fecha de inicio :</strong>{{reserva.FechaInicio}}</p>
     
    <p><strong> Fecha de fin:</strong>{{reserva.FechaFin}}</p>
        
    <p><strong> Monto por día:</strong>{{reserva.MontoPorDia}}</p>
       
</div>

<a href="/Reserva" class="btn btn-secondary">
        Volver
    </a>
</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Reserva.js"></script>  


