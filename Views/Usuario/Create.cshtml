
<div id="app">

    <h1>Crear Usuario</h1>

    <hr />

    <form @@submit.prevent="crearUsuario">

        <div class="mb-3">
            <label>Nombre</label>
            <input v-model="usuario.Nombre"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Apellido</label>
            <input v-model="usuario.Apellido"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input v-model="usuario.Email"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <input v-model="usuario.Password"
                   type="password"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Rol</label>

            <select v-model="usuario.Rol"
                    class="form-control">

                <option value="">Seleccione un rol</option>
                <option value="Administrador">Administrador</option>
                <option value="Empleado">Empleado</option>

            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Crear
        </button>

        <a href="/Usuario" class="btn btn-secondary">
            Volver
        </a>

    </form>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Usuario.js"></script>
