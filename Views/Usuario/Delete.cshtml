
<div id="app" v-cloak>

    <h1>Eliminar Usuario</h1>

    <h3>¿Está seguro de que desea eliminar este usuario?</h3>

    <hr />

    <div v-if="usuario">

        <p>
            <strong>Nombre:</strong>
            {{usuario.Nombre}}
        </p>

        <p>
            <strong>Apellido:</strong>
            {{usuario.Apellido}}
        </p>

        <p>
            <strong>Email:</strong>
            {{usuario.Email}}
        </p>

        <p>
            <strong>Rol:</strong>
            {{usuario.Rol}}
        </p>

    </div>

    <br>

    <button @@click="eliminar"
            class="btn btn-danger">
        Eliminar
    </button>

    <a href="/Usuario"
       class="btn btn-secondary">
        Cancelar
    </a>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Usuario.js"></script>

