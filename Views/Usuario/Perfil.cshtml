<div id="app" v-cloak>

    <h2>Mi Perfil</h2>

    <div class="card mt-3">
        <div class="card-body">

            <div class="text-center mb-4">

                <img v-if="usuario.Avatar"
                     :src="usuario.Avatar"
                     alt="Avatar"
                     class="rounded-circle"
                     style="width: 150px; height: 150px; object-fit: cover;" />

                <div v-else
                     class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto"
                     style="width: 150px; height: 150px;">
                    Sin avatar
                </div>

            </div>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input v-model="usuario.Nombre"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Apellido</label>
                <input v-model="usuario.Apellido"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input v-model="usuario.Email"
                       type="email"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Rol</label>
                <input v-model="usuario.Rol"
                       class="form-control"
                       disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Avatar</label>
                <input type="file"
                       class="form-control"
                       accept="image/*"
                       @@change="seleccionarAvatar" />
            </div>

            <button class="btn btn-primary"
                    @@click="guardarPerfil">
                Guardar cambios
            </button>

        </div>
    </div>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Perfil.js"></script>