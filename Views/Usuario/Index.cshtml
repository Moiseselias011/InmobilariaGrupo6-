
<div id="app">

    <h1>Usuarios</h1>

    <p>
        <a href="/Usuario/Create" class="btn btn-primary">
            Nuevo Usuario
        </a>
    </p>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>Id Usuario</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="usuario in usuarios"
                :key="usuario.IdUsuario">

                <td>{{usuario.IdUsuario}}</td>
                <td>{{usuario.Nombre}}</td>
                <td>{{usuario.Apellido}}</td>
                <td>{{usuario.Email}}</td>
                <td>{{usuario.Rol}}</td>

                <td>

                    <a :href="'/Usuario/Details/' + usuario.IdUsuario"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a :href="'/Usuario/Edit/' + usuario.IdUsuario"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a :href="'/Usuario/Delete/' + usuario.IdUsuario"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>

                </td>

            </tr>

        </tbody>

    </table>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Usuario.js"></script>

