<div id="app">

<h2>Detalles de Inmueble</h2>

<div  v-if="inmueble">
    <p><strong>Direccion:</strong> {{inmueble.Direccion}}</p>
    <p><strong>Cupo:</strong> {{inmueble.Cupo}}</p>
    <p><strong>Coordenadas:</strong> {{inmueble.Coordenadas}}</p>
    <p><strong> PrecioPorDia :</strong> {{inmueble.PrecioPorDia}}</p>
    <p><strong>Disponible</strong> {{inmueble.Disponible}}</p>
    <p><strong>ImagenPortada</strong> {{inmueble.ImagenPortada}} </p>
</div>

<a href="/Inmueble" class="btn btn-secondary">
    Volver
</a>
</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Inmueble.js"></script>