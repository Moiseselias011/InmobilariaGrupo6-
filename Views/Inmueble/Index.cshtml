<div id="app">

<h2>Lista de Inmueble</h2>

<a asp-action="Create" class="btn btn-primary">  Nuevo Inmueble</a>

<table class="table">
    <thead>
        <tr>
           
            <th>Direccion</th>
            <th>Cupo</th>
            <th>Coordenadas</th>
            <th>PrecioPorDia</th>
            <th>Disponible</th>
            <th>ImagenPortada</th>
        </tr>
    </thead>

    <tbody>
       
            <tr v-for="inmueble in inmuebles" 
            :key="inmueble.IdInmueble">
              
                <td>{{inmueble.Direccion}}</td>
                <td>{{inmueble.Cupo}}</td>
                <td>{{inmueble.Coordenadas}}</td>
                <td>{{inmueble.PrecioPorDia}}</td>
                <td>{{inmueble.Disponible}}</td>
                <td>{{inmueble.ImagenPortada}}</td>

                <td>
                    <a :href="'/Inmueble/Edit/' + inmueble.IdInmueble"
                        class="btn btn-warning">
                        Editar
                    </a>

                    <a :href="'/Inmueble/Delete/' + inmueble.IdInmueble"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                    <a :href="'/Inmueble/Details/' + inmueble.IdInmueble"
                       class="btn btn-warning">
                       Details
                    </a> 

                </td>
            </tr>
        
    </tbody>
</table>
</div> 
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Inmueble.js"></script>