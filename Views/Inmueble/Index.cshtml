<div id="app" v-cloak>

    <h2>Lista de Inmueble</h2>

    <a asp-action="Create" class="btn btn-primary">
        Nuevo Inmueble
    </a>

    <table class="table">

        <thead>
            <tr>
                <th>Direccion</th>
                <th>Cupo</th>
                <th>Coordenadas</th>
                <th>PrecioPorDia</th>
                <th>Disponible</th>
                <th>ImagenPortada</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="inmueble in inmuebles"
                :key="inmueble.IdInmueble">

                <td>
                    {{ inmueble.Direccion }}
                </td>

                <td>
                    {{ inmueble.Cupo }}
                </td>

                <td>
                    {{ inmueble.Coordenadas }}
                </td>

                <td>
                    {{ inmueble.PrecioPorDia }}
                </td>

                <td>
                    {{ inmueble.Disponible }}
                </td>

                <td>

                    <img v-if="inmueble.ImagenPortada"
                         :src="inmueble.ImagenPortada"
                         alt="Imagen de portada"
                         style="width: 180px;
                                height: 120px;
                                object-fit: cover;
                                border-radius: 8px;">

                    <span v-else>
                        Sin imagen
                    </span>

                </td>

                <td>

                    <a :href="'/Inmueble/Edit/' + inmueble.IdInmueble"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a :href="'/Inmueble/Delete/' + inmueble.IdInmueble"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                    <a :href="'/Inmueble/Details/' + inmueble.IdInmueble"
                       class="btn btn-info">
                        Details
                    </a>

                </td>

            </tr>

        </tbody>

    </table>

    <hr />

    <h2>Reportes de Inmuebles</h2>

    <h3>Inmuebles y propietarios</h3>

    <select v-model="filtroDisponible"
            class="form-select">

        <option value="">
            Todos
        </option>

        <option value="true">
            Disponibles
        </option>

        <option value="false">
            Suspendidos
        </option>

    </select>

    <br />

    <button class="btn btn-primary"
            v-on:click="listarReporteInmuebles">

        Buscar

    </button>

    <table class="table">

        <thead>
            <tr>
                <th>Direccion</th>
                <th>Cupo</th>
                <th>Precio por día</th>
                <th>Estado</th>
                <th>Propietario</th>
                <th>Tipo</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="inmueble in reporteInmuebles"
                :key="inmueble.IdInmueble">

                <td>
                    {{ inmueble.Direccion }}
                </td>

                <td>
                    {{ inmueble.Cupo }}
                </td>

                <td>
                    {{ inmueble.PrecioPorDia }}
                </td>

                <td>
                    {{ inmueble.Disponible ? "Disponible" : "Suspendido" }}
                </td>

                <td>
                    {{ inmueble.Propietario }}
                </td>

                <td>
                    {{ inmueble.Tipo }}
                </td>

            </tr>

        </tbody>

    </table>

    <hr />

    <h3>Inmuebles por propietario</h3>

    <select v-model="idPropietario"
            class="form-select">

        <option value="">
            Seleccione un propietario
        </option>

        <option v-for="propietario in propietarios"
                :key="propietario.idPropietario"
                :value="propietario.idPropietario">

            {{ propietario.nombre }}
            {{ propietario.apellido }}

        </option>

    </select>

    <br />

    <button class="btn btn-primary"
            v-on:click="listarReporteInmueblesPorPropietario">

        Buscar

    </button>

    <table class="table">

        <thead>
            <tr>
                <th>Direccion</th>
                <th>Cupo</th>
                <th>Precio por día</th>
                <th>Estado</th>
                <th>Tipo</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="inmueble in reporteInmueblesPropietario"
                :key="inmueble.IdInmueble">

                <td>
                    {{ inmueble.Direccion }}
                </td>

                <td>
                    {{ inmueble.Cupo }}
                </td>

                <td>
                    {{ inmueble.PrecioPorDia }}
                </td>

                <td>
                    {{ inmueble.Disponible ? "Disponible" : "Suspendido" }}
                </td>

                <td>
                    {{ inmueble.Tipo }}
                </td>

            </tr>

        </tbody>

    </table>

    <hr />

    <h3>Inmuebles disponibles entre fechas</h3>

    <label>
        Fecha de inicio
    </label>

    <input type="date"
           v-model="fechaInicio"
           class="form-control" />

    <br />

    <label>
        Fecha de fin
    </label>

    <input type="date"
           v-model="fechaFin"
           class="form-control" />

    <br />

    <button class="btn btn-primary"
            v-on:click="listarReporteInmueblesDisponibles">

        Buscar

    </button>

    <table class="table">

        <thead>
            <tr>
                <th>Direccion</th>
                <th>Cupo</th>
                <th>Precio por día</th>
                <th>Propietario</th>
                <th>Tipo</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="inmueble in reporteInmueblesDisponibles"
                :key="inmueble.IdInmueble">

                <td>
                    {{ inmueble.Direccion }}
                </td>

                <td>
                    {{ inmueble.Cupo }}
                </td>

                <td>
                    {{ inmueble.PrecioPorDia }}
                </td>

                <td>
                    {{ inmueble.Propietario }}
                </td>

                <td>
                    {{ inmueble.Tipo }}
                </td>

            </tr>

        </tbody>

    </table>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Inmueble.js"></script>