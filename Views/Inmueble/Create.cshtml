<div id="app">

<h2>Nuevo Inmueble</h2>

<form @@submit.prevent="crearInmueble">

    <label>Dirección</label>
    <input v-model="inmueble.Direccion" class="form-control" />

    <label>Cupo</label>
    <input v-model="inmueble.Cupo" class="form-control" />

    <label>Coordenadas</label>
    <input v-model="inmueble.Coordenadas" class="form-control" />

    <label>Precio por día</label>
    <input v-model="inmueble.PrecioPorDia" class="form-control" />

    
    <label>Tipo de Inmueble</label>
    <select v-model="inmueble.IdTipoInmueble" class="form-control">
    <option value="0">-- Seleccione un tipo --</option>

    <option v-for="tipo in tipos"
            :key="tipo.IdTipoInmueble"
            :value="tipo.IdTipoInmueble">
        {{tipo.Nombre}}
    </option>
    </select>

    <label>Disponible</label>
    <input v-model="inmueble.Disponible" type="checkbox" />

    <label>Imagen de portada</label>
    <input v-model="inmueble.ImagenPortada" class="form-control" />

    <br>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a href="/Inmueble" class="btn btn-secondary">
        Cancelar
    </a>

    </form>

</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script> 
<script src="~/vue/Inmueble.js"></script>