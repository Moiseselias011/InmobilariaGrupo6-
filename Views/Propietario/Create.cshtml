<div id="app">


<h2>Nuevo Propietario</h2>

<form @@submit.prevent="crearPropietario">

    <label>Nombre</label>
    <input v-model="propietario.nombre" class="form-control" />

    <label>Apellido</label>
    <input v-model="propietario.apellido" class="form-control" />

    <label>DNI</label>
    <input v-model="propietario.dni" class="form-control" />

    <label>Teléfono</label>
    <input v-model="propietario.telefono" class="form-control" />

    <label>Email</label>
    <input v-model="propietario.email" type="email" class="form-control" />

    <br>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a href="/Propietario" class="btn btn-secondary">
        Cancelar
    </a>

</form>


</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script> 
<script src="~/vue/Propietario.js"></script>