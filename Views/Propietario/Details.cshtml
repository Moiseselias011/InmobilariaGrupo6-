@model InmobilariaGrupo6_.Models.Propietario

<h2>Detalles de Propietario</h2>

<div>
    <p><strong>ID:</strong> @Model.idPropietario</p>
    <p><strong>Nombre:</strong> @Model.nombre</p>
    <p><strong>apellido:</strong> @Model.apellido</p>
    <p><strong> dni :</strong> @Model.dni</p>
    <p><strong>telefono</strong> @Model.telefono</p>
    <p><strong>email</strong> @Model.email </p>
</div>

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>