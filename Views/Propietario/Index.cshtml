@model IEnumerable<InmobilariaGrupo6_.Models.Propietario>



<div id="app">

<h2>Lista de Propietarios</h2>


<a asp-action="Create" class="btn btn-primary">Nuevo Propietario</a>

<table class="table">
   <thead>
      <tr>
           <th>Nombre</th>
           <th>Apellido</th>
           <th>Dni</th>
           <th>Telefono</th>
           <th>Gmail</th>
           <th>Acciones</th>
      </tr>      
 </thead>  
   <tbody>
        
        
            <tr v-for="propietario in propietarios" 
            :key="propietario.idPropietario">

                <td>{{propietario.nombre}}</td>
                <td>{{propietario.apellido}}</td>
                <td>{{propietario.dni}}</td>
                <td>{{propietario.telefono}}</td>
                <td>{{propietario.email}}</td>

                <td>
                    <a :href="'/Propietario/Edit/' + propietario.idPropietario"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a :href="'/Propietario/Delete/' + propietario.idPropietario"
                       class="btn btn-danger">
                        Eliminar
                    </a>
                    <a :href="'/Propietario/Details/' + propietario.idPropietario"
                       class="btn btn-warning">
                       Details
                    </a> 
                </td>
            </tr>
    </tbody>
</table>   
</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/app.js"></script>