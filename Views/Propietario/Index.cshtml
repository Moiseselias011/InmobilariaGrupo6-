@model IEnumerable<INMOBILIARIAGRUPO6.Models.Propietario>
<h2>Lista de Propietarios</h2>


<a asp-action="Create" class="btn btn-primary">Nuevo Propietario</a>

<table class="table">
   <thead>
      <tr>
           <th>Nombre</th>
           <th>Apellido</th>
           <th>Dni</th>
           <th>Telefono</th>
           <th>Gmail</th>
           <th>Acciones</th>
      </tr>      
 </thead>  
   <tbody>
        @foreach (var propietario in Model)
        {
            <tr>
                <td>@propietario.nombre</td>
                <td>@propietario.apellido</td>
                <td>@propietario.dni</td>
                <td>@propietario.telefono</td>
                <td>@propietario.email</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@propietario.idPropietario"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@propietario.idPropietario"
                       class="btn btn-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>   
