<div id="app">

    <h2>Eliminar Propietario</h2>

    <div v-if="propietario">
        <p><strong>Nombre:</strong> {{ propietario.nombre }}</p>
        <p><strong>Apellido:</strong> {{ propietario.apellido }}</p>
        <p><strong>DNI:</strong> {{ propietario.dni }}</p>
        <p><strong>Teléfono:</strong> {{ propietario.telefono }}</p>
        <p><strong>Email:</strong> {{ propietario.email }}</p>
    </div>

    <br>

    <button @@click="eliminar" class="btn btn-danger">
        Eliminar
    </button>

    <a class="btn btn-secondary" href="/Propietario">
        Cancelar
    </a>

</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Propietario.js"></script>