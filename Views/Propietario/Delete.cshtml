@model InmobilariaGrupo6_.Models.Propietario

<h2>Eliminar Propietario</h2>

<div>
    <p><strong>Nombre:</strong> @Model.nombre</p>
    <p><strong>Apellido:</strong> @Model.apellido</p>
    <p><strong>DNI:</strong> @Model.dni</p>
    <p><strong>Teléfono:</strong> @Model.telefono</p>
    <p><strong>Email:</strong> @Model.email</p>
</div>

<br>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" name="id" value="@Model.idPropietario" />

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    <a class="btn btn-secondary" href="/Propietario">
        Cancelar
    </a>

</form>