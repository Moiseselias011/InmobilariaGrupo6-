<div id="app">

<h2>Edit Tipo de Inmueble</h2>

<form @@submit.prevent="editarTipoInmueble">

    <input type="hidden" v-model="tipoinmueble.IdTipoInmueble"/>

    <div class="mb-3">
        <label>Nombre</label>
        <input v-model="tipoinmueble.Nombre" class="form-control" />
    </div>


<button type="submit" class="btn btn-success">Guardar cambio</button>

<a class="btn btn-secondary" href="/TipoInmueble">Cancelar</a>

</form>

</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/TipoInmueble.js"></script>