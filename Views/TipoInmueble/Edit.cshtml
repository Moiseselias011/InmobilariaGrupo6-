@model InmobilariaGrupo6_.Models.TipoInmueble

<h2>Edit Tipo de Inmueble</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="IdTipoInmueble" />

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>


    <button type="submit" class="btn btn-success">  Guardar cambio    </button>

    <a class="btn btn-secondary" href="/TipoInmueble"> Cancelar</a>

</form>