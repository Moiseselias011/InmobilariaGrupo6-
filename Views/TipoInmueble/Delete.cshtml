@model INMOBILIARIAGRUPO6.Models.TipoInmueble

<h2>Eliminar TipoInmueble</h2>

<div>
    <p><strong>Nombre:</strong> @Model.Nombre</p>
    
</div>

<br>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" name="id" value="@Model.IdTipoInmueble" />

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    <a class="btn btn-secondary" href="/TipoInmueble">
        Cancelar
    </a>

</form>