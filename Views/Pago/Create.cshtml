<div id="app" v-cloak>

    <h2>Nuevo Pago</h2>

    <form @@submit.prevent="crearPago">

        <label>Reserva</label>

        <select v-model="pago.IdReserva"
                @@change="seleccionarReserva"
                class="form-control">

            <option value="0">
                Seleccione una reserva
            </option>

            <option v-for="reserva in reservas"
                    :key="reserva.IdReserva"
                    :value="reserva.IdReserva">

                Reserva #{{ reserva.IdReserva }}
                -
                {{ reserva.Inquilino
                    ? reserva.Inquilino.NombreCompleto
                    : '' }}
                -
                {{ reserva.Inmueble
                    ? reserva.Inmueble.Direccion
                    : '' }}

            </option>

        </select>

        <br />

        <div v-if="reservaSeleccionada">

            <p>
                <strong>Inquilino:</strong>
                {{ reservaSeleccionada.Inquilino
                    ? reservaSeleccionada.Inquilino.NombreCompleto
                    : '' }}
            </p>

            <p>
                <strong>Inmueble:</strong>
                {{ reservaSeleccionada.Inmueble
                    ? reservaSeleccionada.Inmueble.Direccion
                    : '' }}
            </p>

            <p>
                <strong>Fecha de inicio:</strong>
                {{ reservaSeleccionada.FechaInicio }}
            </p>

            <p>
                <strong>Fecha de fin:</strong>
                {{ reservaSeleccionada.FechaFin }}
            </p>

            <p>
                <strong>Monto por día:</strong>
                ${{ reservaSeleccionada.MontoPorDia }}
            </p>

            <p>
                <strong>Cantidad de días:</strong>
                {{ cantidadDias }}
            </p>

        </div>

        <br />

        <label>Fecha de Pago</label>

        <input v-model="pago.FechaPago"
               type="date"
               class="form-control" />

        <br />

        <label>Monto Total</label>

        <input v-model="pago.Monto"
               type="number"
               step="0.01"
               class="form-control"
               readonly />

        <br />

        <label>Método de Pago</label>

        <select v-model="pago.MetodoPago"
                class="form-control">

            <option value="">
                Seleccione un método
            </option>

            <option value="Efectivo">
                Efectivo
            </option>

            <option value="Transferencia">
                Transferencia
            </option>

            <option value="Tarjeta">
                Tarjeta
            </option>

        </select>

        <br />

        <button type="submit"
                class="btn btn-success">

            Guardar

        </button>

        <a href="/Pago"
           class="btn btn-secondary">

            Cancelar

        </a>

    </form>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Pago.js"></script>