<style>
    [v-cloak] {
        display: none;
    }
</style>

<div id="app" v-cloak>

    <h2>Lista de Pagos</h2>

    <a href="/Pago/Create" class="btn btn-primary">
        Nuevo Pago
    </a>

    <br />
    <br />

    <table class="table">

        <thead>
            <tr>
                <th>Fecha Pago</th>
                <th>Monto</th>
                <th>Método de Pago</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="pago in pagos"
                :key="pago.IdPago">

                <td>{{ pago.FechaPago }}</td>

                <td>{{ pago.Monto }}</td>

                <td>{{ pago.MetodoPago }}</td>

                <td>

                    <span v-if="pago.Anulado">
                        Anulado
                    </span>

                    <span v-else>
                        Activo
                    </span>

                </td>

                <td>

                    <a v-if="!pago.Anulado"
                       :href="'/Pago/Edit/' + pago.IdPago"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a v-if="!pago.Anulado"
                       :href="'/Pago/Delete/' + pago.IdPago"
                       class="btn btn-danger">
                        Anular
                    </a>

                    <a :href="'/Pago/Details/' + pago.IdPago"
                       class="btn btn-info">
                        Details
                    </a>

                </td>

            </tr>

        </tbody>

    </table>

    <hr />

    <h2>Reporte de Pagos por Reserva</h2>

    <label>Seleccione una reserva</label>

    <select v-model="reservaReporte"
            class="form-control">

        <option value="">
            Seleccione una reserva
        </option>

        <option v-for="reserva in reservas"
                :key="reserva.IdReserva"
                :value="reserva.IdReserva">

            Reserva {{ reserva.IdReserva }}
            -
            {{ reserva.FechaInicio }}
            a
            {{ reserva.FechaFin }}

        </option>

    </select>

    <br />

    <button class="btn btn-primary"
            v-on:click="listarPagosPorReserva">

        Buscar pagos

    </button>

    <br />
    <br />

    <table class="table"
           v-if="pagosReporte.length > 0">

        <thead>

            <tr>
                <th>Fecha Pago</th>
                <th>Monto</th>
                <th>Método de Pago</th>
                <th>Estado</th>
            </tr>

        </thead>

        <tbody>

            <tr v-for="pago in pagosReporte"
                :key="pago.IdPago">

                <td>{{ pago.FechaPago }}</td>

                <td>{{ pago.Monto }}</td>

                <td>{{ pago.MetodoPago }}</td>

                <td>

                    <span v-if="pago.Anulado">
                        Anulado
                    </span>

                    <span v-else>
                        Activo
                    </span>

                </td>

            </tr>

        </tbody>

    </table>

    <p v-if="reservaReporte && pagosReporte.length === 0">
        No hay pagos registrados para esta reserva.
    </p>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Pago.js"></script>