<div id="app">

    <h2>Detalles del Pago</h2>

    <div>

        <p>
            <strong>Id Pago:</strong>
            {{ pago.IdPago }}
        </p>

        <p>
            <strong>Id Reserva:</strong>
            {{ pago.IdReserva }}
        </p>

        <p>
            <strong>Fecha de Pago:</strong>
            {{ pago.FechaPago }}
        </p>

        <p>
            <strong>Monto:</strong>
            {{ pago.Monto }}
        </p>

        <p>
            <strong>Método de Pago:</strong>
            {{ pago.MetodoPago }}
        </p>

        <p>
            <strong>Estado:</strong>

            <span v-if="pago.Anulado">
                Anulado
            </span>

            <span v-else>
                Activo
            </span>

        </p>


        @if (User.IsInRole("Administrador"))
        {
            <hr />

            <h3>Auditoría</h3>

            <p>
                <strong>Creado por:</strong>

                {{ pago.UsuarioCreacion
                    ? pago.UsuarioCreacion.Nombre + ' ' + pago.UsuarioCreacion.Apellido
                    : 'No disponible' }}
            </p>

            <p>
                <strong>Anulado por:</strong>

                {{ pago.UsuarioAnulacion
                    ? pago.UsuarioAnulacion.Nombre + ' ' + pago.UsuarioAnulacion.Apellido
                    : 'El pago no fue anulado' }}
            </p>
        }

    </div>


    <a v-if="!pago.Anulado"
       :href="'/Pago/Edit/' + pago.IdPago"
       class="btn btn-warning">
        Editar
    </a>

    <a href="/Pago"
       class="btn btn-secondary">
        Volver
    </a>

</div>


<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script src="~/vue/Pago.js"></script>