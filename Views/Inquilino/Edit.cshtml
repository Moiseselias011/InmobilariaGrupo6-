<div id="app">
     <h2>Edit Inquilino</h2>


<form @@submit.prevent="editarInquilino">

<input type="hidden" v-model="inquilino.IdInquilino" />


 <div class="mb-3">
   <label> DNI </label>
 <input v-model="inquilino.DNI" class="form-control" />
 </div>
 
 <div class="mb-3">
   <label> NombreCompleto </label>
   <input v-model="inquilino.NombreCompleto" class="form-control"/>  
 </div> 
  
 <div class="mb-3">
   <label> Telefono </label> 
   <input v-model="inquilino.Telefono" class="form-control"/>
 </div>

 <div class="mb-3">
  <label> Email </label>
  <input v-model="inquilino.Email" type="email" class="form-control"/>
 </div>
 
 <button type="submit" class ="btn btn-success">Guardar cambios</button>

 <a class="btn btn-secondary" href="/Inquilino">
 Cancelar </a>


</form> 

</div>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Inquilino.js"></script>