@model IEnumerable<InmobilariaGrupo6_.Models.Inquilino>

<h2>Lista de Inquilinos</h2>

<a asp-action="Create" class="btn btn-primary">
    Nuevo Inquilino
</a>

<table class="table">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre Completo</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var inquilino in Model)
        {
            <tr>
                <td>@inquilino.DNI</td>
                <td>@inquilino.NombreCompleto</td>
                <td>@inquilino.Telefono</td>
                <td>@inquilino.Email</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@inquilino.Id"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@inquilino.Id"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@inquilino.Id"
                       class="btn btn-warning">
                       Details
                    </a> 

                </td>
            </tr>
        }
    </tbody>
</table>