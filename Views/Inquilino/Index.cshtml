<div id="app" v-cloak>

    <h2>Lista de Inquilinos</h2>

    <a asp-action="Create" class="btn btn-primary">
        Nuevo Inquilino
    </a>

    <br />
    <br />

    <div class="row">

        <div class="col-md-6">

            <input type="text"
                   v-model="buscar"
                   v-on:keyup.enter="listarInquilinos"
                   class="form-control"
                   placeholder="Buscar por nombre completo..." />

        </div>

        <div class="col-md-2">

            <button class="btn btn-primary"
                    v-on:click="listarInquilinos">

                Buscar

            </button>

        </div>

    </div>

    <br />

    <table class="table">

        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombre Completo</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            <tr v-for="inquilino in inquilinos"
                :key="inquilino.IdInquilino">

                <td>
                    {{ inquilino.DNI }}
                </td>

                <td>
                    {{ inquilino.NombreCompleto }}
                </td>

                <td>
                    {{ inquilino.Telefono }}
                </td>

                <td>
                    {{ inquilino.Email }}
                </td>

                <td>

                    <a :href="'/Inquilino/Edit/' + inquilino.IdInquilino"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a :href="'/Inquilino/Delete/' + inquilino.IdInquilino"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                    <a :href="'/Inquilino/Details/' + inquilino.IdInquilino"
                       class="btn btn-warning">
                        Details
                    </a>

                </td>

            </tr>

        </tbody>

    </table>

    <div class="d-flex align-items-center gap-2">

        <button class="btn btn-secondary"
                v-on:click="paginaAnterior"
                :disabled="pagina <= 1">

            Anterior

        </button>

        <span>
            Página {{ pagina }} de {{ totalPaginas }}
        </span>

        <button class="btn btn-secondary"
                v-on:click="paginaSiguiente"
                :disabled="pagina >= totalPaginas">

            Siguiente

        </button>

    </div>

</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="~/vue/Inquilino.js"></script>